{
  "name": "horse-racing-backend",
  "version": "1.0.0",
  "description": "Backend for Horse Racing Prediction Platform",
  "type": "module",
  "main": "build/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/database/migrations build/database/",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node build/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "DB_DATABASE=${TEST_DB_DATABASE:-horse_racing_test} node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "migrate:prod": "node build/database/migrate.js",
    "seed:prod": "node build/database/seed.js"
  },
  "keywords": [
    "horse-racing",
    "predictions",
    "betting"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
