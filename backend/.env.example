HOST=0.0.0.0
PORT=3333
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Same value as DB_PASSWORD in the root .env used by docker compose
DB_PASSWORD=
DB_DATABASE=horse_racing_predictor

# Auth
# Required in production (32+ random characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development an insecure default is used when empty.
JWT_SECRET=

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the API (so rate limiting sees client IPs)
# TRUST_PROXY=1

# CORS
CORS_ORIGIN=http://localhost:5173

# Demo data: password of the admin account created by `npm run seed`
# (random and printed by the seed when empty)
SEED_ADMIN_PASSWORD=
