# Variables read by docker-compose.yml. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env

# PostgreSQL password (required). Any value works for local development;
# use the same value for DB_PASSWORD in backend/.env.
#   openssl rand -hex 16
DB_PASSWORD=

# Only needed for the full stack (backend container): 32+ random characters
#   openssl rand -hex 32
JWT_SECRET=
